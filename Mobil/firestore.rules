rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para tus jugadores (ajusta según lo que ya tengas)
    match /jugadores/{playerId} {
      allow read, write: if true; 
    }

    // REGLA PARA LOS TOKENS: Permite a los dispositivos registrar su token
    match /fcm_tokens/{token} {
      allow read, write: if true;
    }
  }
}
